# ---------------------------------------------------------------------------
# PatientServer environment variables
#
# Copy this file to a real .env (or export the values in your shell) and fill
# them in. NEVER commit real secrets — `.env` is git-ignored, this template is
# safe to commit.
# ---------------------------------------------------------------------------

# --- Server ---
PORT=8080

# --- Database (provide EITHER DATABASE_URL OR the PG* set below) ---
DATABASE_URL=postgresql://user:password@localhost:5432/patient_monitoring?sslmode=require
# PGHOST=localhost
# PGPORT=5432
# PGDATABASE=patient_monitoring
# PGUSER=user
# PGPASSWORD=password

# --- Public base URL (used to build email verification links) ---
APP_BASE_URL=http://localhost:8080

# --- SMTP for verification emails ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=no-reply@example.com
SMTP_PASS=change-me
SMTP_FROM=no-reply@example.com

# --- Dev/demo only: auto-verify new accounts and skip sending verification email ---
SKIP_EMAIL_VERIFICATION=false
